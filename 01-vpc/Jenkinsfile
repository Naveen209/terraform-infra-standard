pipeline {
    agent {
    label 'Agent-1'
    } 

    stages {
        stage('Init') {
            steps {
                sh 'pwd'
                cd '01-vpc'
                sh 'ls -lrth'
                echo 'Initialising..'
                sh 'terraform init'
                
            }
        }
        stage('Plan') {
            steps {
                sh 'pwd'
                cd '01-vpc'
                sh 'ls -lrth'
                echo 'Planning..'
                sh 'terraform plan'
                
            }
        }
        
        stage('Deploy') {
            steps {
                
                echo 'Deploying....'
                sh 'pwd'
                sh 'ls -lrth'
                

            }
        }
        
    }


    post { 
        always { 
            echo 'I will always say Hello again!'
        }
        success{
            echo 'I will run when job success'
        }
        failure{
            echo 'I will run when job failure'
        }
        fixed{
            echo 'I will run when job got fixed'
        }
    }
}