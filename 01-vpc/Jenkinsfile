pipeline {
    agent {
    label 'Agent-1'
    } 
    options{
        ansiColor('xterm')
    }

    stages {
        stage('Init') {
            steps {
                sh '''
                pwd
                cd 01-vpc
                ls -lrth
                terraform init
                '''
                
            }
        }
        stage('Plan') {
            steps {
                sh '''
                pwd
                cd 01-vpc
                ls -lrth
                terraform plan
                '''
                
            }
        }
        
        stage('Deploy') {
            steps {
                
                echo 'Deploying....'
                sh 'pwd'
                sh 'ls -lrth'
                

            }
        }
        
    }


    post { 
        always { 
            echo 'I will always say Hello again!'
        }
        success{
            echo 'I will run when job success'
        }
        failure{
            echo 'I will run when job failure'
        }
        fixed{
            echo 'I will run when job got fixed'
        }
    }
}